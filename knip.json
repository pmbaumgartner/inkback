{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["express", "@anthropic-ai/mcpb"],
  "workspaces": {
    ".": {
      "entry": ["scripts/start-mcp-test-host.mjs"]
    },
    "packages/cli": {
      "entry": ["build-release.mjs"]
    },
    "packages/app": {
      "entry": ["src/mcp-app/main.tsx", "e2e/*.ts"]
    },
    "packages/server": {
      "entry": ["src/cli.ts", "src/index.ts", "test-support/*.ts"]
    }
  }
}
