{
  "name": "name-placeholder",
  "version": "0.1.0",
  "description": "A local markdown review app",
  "license": "MIT",
  "author": "Nathan Baschez",
  "bin": {
    "name-placeholder": "./packages/server/bin/name-placeholder.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "lint": "biome check . --assist-enabled=false",
    "lint:fix": "biome check --write . --assist-enabled=false",
    "unused": "knip --no-progress",
    "format": "biome format --write .",
    "test": "pnpm --filter @name-placeholder/rfm test && pnpm --filter @name-placeholder/app test && pnpm --filter @name-placeholder/server test",
    "test:e2e": "playwright test --config packages/app/playwright.config.ts",
    "test:smoke": "playwright test --config packages/app/playwright.config.ts --grep @smoke",
    "test:package": "node scripts/test-package.mjs",
    "test:coverage": "pnpm --filter @name-placeholder/app exec vitest run --coverage && pnpm --filter @name-placeholder/server exec vitest run --coverage",
    "check": "pnpm lint && pnpm test && pnpm build",
    "build": "pnpm --filter @name-placeholder/rfm build && pnpm --filter @name-placeholder/app build && pnpm --filter @name-placeholder/server build"
  },
  "files": [
    "packages/app/dist",
    "packages/rfm/dist",
    "packages/rfm/package.json",
    "packages/server/dist",
    "packages/server/bin",
    "packages/server/defaults.mjs",
    "packages/server/defaults.d.mts",
    "packages/skill/name-placeholder"
  ],
  "dependencies": {
    "@name-placeholder/rfm": "file:packages/rfm",
    "express": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "knip": "^6.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
