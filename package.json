{
  "name": "inkback",
  "version": "0.1.0",
  "description": "A local markdown review app",
  "license": "MIT",
  "author": "Nathan Baschez",
  "bin": {
    "inkback": "./packages/server/bin/inkback.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "lint": "biome check . --assist-enabled=false",
    "lint:fix": "biome check --write . --assist-enabled=false",
    "unused": "knip --no-progress",
    "format": "biome format --write .",
    "test": "pnpm --filter @inkback/rfm test && pnpm --filter @inkback/app test && pnpm --filter @inkback/server test",
    "test:e2e": "playwright test --config packages/app/playwright.config.ts",
    "test:smoke": "playwright test --config packages/app/playwright.config.ts --grep @smoke",
    "test:package": "node scripts/test-package.mjs",
    "test:coverage": "pnpm --filter @inkback/app exec vitest run --coverage && pnpm --filter @inkback/server exec vitest run --coverage",
    "check": "pnpm lint && pnpm test && pnpm build",
    "build": "pnpm --filter @inkback/rfm build && pnpm --filter @inkback/app build && pnpm --filter @inkback/server build && node scripts/check-mcp-app-size.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "files": [
    "packages/app/dist",
    "packages/rfm/dist",
    "packages/rfm/package.json",
    "packages/server/dist",
    "packages/server/bin",
    "packages/server/defaults.mjs",
    "packages/server/defaults.d.mts",
    "packages/skill/inkback",
    "packages/app/dist-mcp-app",
    "LICENSE"
  ],
  "dependencies": {
    "@inkback/rfm": "file:packages/rfm",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "^2.4.12",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "knip": "^6.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24"
  }
}
